<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ACCESS_MOCK_LOCATION: Android 6.0 之前用于声明具备模拟位置权限。
      6.0 起改用开发者选项的「选择模拟位置应用」。
      现代设备不再需要此权限，但保留以便理解。
    -->
    <!--
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="ProtectedPermissions" />
    -->

    <application>
        <!--
          模拟定位保活服务。foregroundServiceType=location 与 :app Manifest 中
          FOREGROUND_SERVICE_LOCATION 权限配套（Android 14 / targetSdk 34+ 强制）。
          exported=false：仅供本进程内部启停。
          权限声明在 :app，library manifest 合并后生效。
        -->
        <service
            android:name="com.fakelocation.core.mock.MockLocationService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
